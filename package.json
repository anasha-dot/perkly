{
  "name": "perkly",
  "private": true,
  "version": "0.0.0",
  "description": "Perkly local application. Membership billing is a later task.",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:migrate": "node packages/database/src/cli.ts migrate",
    "db:reset:test": "node packages/database/src/cli.ts reset-test",
    "db:seed:local": "node packages/database/src/cli.ts seed-local",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false --noEmit && npm run typecheck -w @perkly/web",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node scripts/test-integration.ts",
    "test:smoke:database": "node scripts/test-smoke-database.ts",
    "test:e2e": "playwright test",
    "check:container": "sh scripts/check-container.sh",
    "build": "tsc -b --pretty false && npm run build -w @perkly/web",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "start:api": "npm run start -w @perkly/api",
    "start:worker": "npm run start -w @perkly/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vue-eslint-parser": "10.4.1"
  }
}
